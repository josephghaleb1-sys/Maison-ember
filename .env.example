# Copy this file to .env.local and fill in real values from your Supabase
# project (Project Settings -> API).
#
# NEXT_PUBLIC_* vars are exposed to the browser — only put the public
# anon key here, never the service role key.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# The slug of the business this deployment serves (matches supabase/seed/maison_ember.sql).
NEXT_PUBLIC_BUSINESS_SLUG=maison-ember
