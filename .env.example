# Copy to .env.local and fill in real values from your Supabase project
# (Supabase Dashboard -> Project Settings -> API).
#
# NEXT_PUBLIC_* variables are compiled into the browser bundle. Only the
# publishable "anon" key belongs here — never the service-role key, which
# bypasses Row Level Security. This project never uses the service-role key:
# every query runs as the signed-in user (or as an anonymous visitor) and RLS
# decides what is allowed.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-publishable-key

# Which business this deployment serves when the request's hostname isn't
# listed in the business_domains table (local development, preview URLs, or a
# one-project-per-customer setup). Must match a businesses.slug value.
NEXT_PUBLIC_BUSINESS_SLUG=veloura-lab

# Optional. Absolute origin used to build password-reset links and canonical
# URLs when a business has no primary domain configured. Vercel sets a usable
# host header, so this is normally only needed for unusual proxy setups.
# NEXT_PUBLIC_SITE_URL=https://example.com

# ---------------------------------------------------------------------------
# Order notification emails (optional)
# ---------------------------------------------------------------------------
# When these are set, every new order is emailed to the address the owner
# enters in Dashboard -> Website -> Order notifications, with a button that
# opens the order in the dashboard to confirm or cancel it. Without them the
# app runs exactly as before and simply logs that the email was skipped —
# ordering never depends on the mail provider.
#
# Get a key at resend.com (free tier is plenty for a small shop). These are
# server-only: no NEXT_PUBLIC_ prefix, so they never reach the browser.

# RESEND_API_KEY=re_your_key_here
# Must be a domain you verified with Resend. Until you verify one, leave it
# unset and Resend's shared sender (onboarding@resend.dev) is used.
# ORDER_EMAIL_FROM=Veloura Lab <orders@yourdomain.com>
# Override the API endpoint. Only needed for local testing or a compatible relay.
# RESEND_API_URL=https://api.resend.com/emails
