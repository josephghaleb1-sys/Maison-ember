# Copy this file to .env.local and fill in real values from your Supabase
# project (Supabase Dashboard -> Project Settings -> API).
#
# NEVER put the service_role key in this file or anywhere in the app. Every
# NEXT_PUBLIC_* value below is compiled into the browser bundle and is public
# by design — the anon key is safe there precisely because Row Level Security,
# not key secrecy, is what protects the data.

# ---- Required ---------------------------------------------------------------

# Your project URL, e.g. https://abcdefghijklm.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# The "anon" / "publishable" public API key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# ---- Business resolution ----------------------------------------------------
#
# Which business this deployment serves when the request's hostname is not
# found in the `business_domains` table.
#
# Production multi-tenant setups resolve by hostname and can leave this unset.
# It is what makes local development work (localhost matches no domain row),
# and it is also the whole configuration for a single-tenant deployment where
# one business has a Vercel project to itself.
NEXT_PUBLIC_BUSINESS_SLUG=bookshop

# ---- Optional ---------------------------------------------------------------

# Absolute origin used to build password-reset links. Leave unset to derive it
# from the incoming request, which is correct in most deployments. Set it if
# your app sits behind a proxy that rewrites the Host header.
# NEXT_PUBLIC_SITE_URL=https://your-domain.com
